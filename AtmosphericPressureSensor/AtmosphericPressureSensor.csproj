<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UtilsLibrary\UtilsLibrary.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="AtmosphericPressureSensor.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="if $(ConfigurationName) == Release  copy /Y  $(OutDir)$(TargetFileName)  $(SolutionDir)deploy&#xD;&#xA;if $(ConfigurationName) == Release  copy /Y  $(OutDir)$(TargetName).json  $(SolutionDir)deploy&#xD;&#xA;" />
  </Target>

</Project>
